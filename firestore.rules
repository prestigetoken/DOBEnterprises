rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() > 0 && id.size() <= 64;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'daleobeirned@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /studios/{studioId} {
      allow read: if true;
      allow create, update: if isValidId(studioId) &&
        request.resource.data.studioId is string &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.cash is number &&
        request.resource.data.netWorth is number &&
        request.resource.data.lastActive is number;
      allow delete: if isAdmin();
    }

    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) &&
        request.resource.data.messageId is string &&
        request.resource.data.studioId is string &&
        request.resource.data.studioName is string &&
        request.resource.data.studioName.size() <= 60 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 300 &&
        request.resource.data.timestamp is number;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /lawsuits/{lawsuitId} {
      allow read: if true;
      allow create: if isValidId(lawsuitId) &&
        request.resource.data.lawsuitId is string &&
        request.resource.data.plaintiffId is string &&
        request.resource.data.defendantId is string &&
        request.resource.data.claimAmount is number &&
        request.resource.data.status is string &&
        request.resource.data.createdAt is number;
      allow update: if isValidId(lawsuitId) &&
        request.resource.data.status in ['pending', 'settled', 'dismissed', 'countersued'];
      allow delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isValidId(roomId) &&
        request.resource.data.roomId is string &&
        request.resource.data.hostId is string &&
        request.resource.data.hostName is string &&
        request.resource.data.status in ['waiting', 'in_progress', 'completed'];
      allow update: if isValidId(roomId) &&
        request.resource.data.status in ['waiting', 'in_progress', 'completed'];
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isValidId(memberId) &&
          request.resource.data.memberId is string &&
          request.resource.data.studioName is string &&
          request.resource.data.isReady is bool;
        allow delete: if true;
      }
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /friends/{friendId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    match /friend_requests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId) &&
        request.resource.data.requestId is string &&
        request.resource.data.senderId is string &&
        request.resource.data.receiverId is string &&
        request.resource.data.status in ['pending', 'accepted', 'declined'];
      allow update: if isValidId(requestId) &&
        request.resource.data.status in ['pending', 'accepted', 'declined'];
      allow delete: if request.auth != null || isAdmin();
    }
  }
}
