rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() > 0 && id.size() <= 64;
    }

    match /studios/{studioId} {
      allow read: if true;
      allow create, update: if isValidId(studioId) &&
        request.resource.data.studioId is string &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.cash is number &&
        request.resource.data.netWorth is number &&
        request.resource.data.lastActive is number;
      allow delete: if false;
    }

    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) &&
        request.resource.data.messageId is string &&
        request.resource.data.studioId is string &&
        request.resource.data.studioName is string &&
        request.resource.data.studioName.size() <= 60 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 300 &&
        request.resource.data.timestamp is number;
      allow update, delete: if false;
    }

    match /lawsuits/{lawsuitId} {
      allow read: if true;
      allow create: if isValidId(lawsuitId) &&
        request.resource.data.lawsuitId is string &&
        request.resource.data.plaintiffId is string &&
        request.resource.data.defendantId is string &&
        request.resource.data.claimAmount is number &&
        request.resource.data.status is string &&
        request.resource.data.createdAt is number;
      allow update: if isValidId(lawsuitId) &&
        request.resource.data.status in ['pending', 'settled', 'dismissed', 'countersued'];
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isValidId(roomId) &&
        request.resource.data.roomId is string &&
        request.resource.data.hostId is string &&
        request.resource.data.hostName is string &&
        request.resource.data.status in ['waiting', 'in_progress', 'completed'];
      allow update: if isValidId(roomId) &&
        request.resource.data.status in ['waiting', 'in_progress', 'completed'];
      allow delete: if false;

      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isValidId(memberId) &&
          request.resource.data.memberId is string &&
          request.resource.data.studioName is string &&
          request.resource.data.isReady is bool;
        allow delete: if true;
      }
    }
  }
}
